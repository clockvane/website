---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import Card from '../../components/ui/Card.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { howWeWork as copy } from '../../content/how-we-work';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="container page">
    <PageHeader title={copy.heading} lede={copy.lede} />
    <section aria-labelledby="how-steps">
      <h2 id="how-steps">{copy.steps.heading}</h2>
      <div class="content"><ProcessSteps steps={copy.steps.items} /></div>
    </section>
    <section class="measure" aria-labelledby="how-support">
      <h2 id="how-support">{copy.support.heading}</h2>
      <p>{copy.support.body}</p>
    </section>
    <section class="measure" aria-labelledby="how-models">
      <h2 id="how-models">{copy.models.heading}</h2>
      <ul>{copy.models.items.map((item) => <li>{item}</li>)}</ul>
      <p>{copy.models.placeholder}</p>
    </section>
    <section class="measure" aria-labelledby="how-pricing">
      <h2 id="how-pricing">{copy.pricing.heading}</h2>
      <p>{copy.pricing.body}</p>
    </section>
    <section class="measure" aria-labelledby="how-handover">
      <h2 id="how-handover">{copy.handover.heading}</h2>
      <p>{copy.handover.body}</p>
    </section>
    <section aria-labelledby="how-faq">
      <h2 id="how-faq">{copy.faq.heading}</h2>
      <div class="content faq">
        {copy.faq.items.map((item) => <Card {...item} />)}
      </div>
    </section>
  </div>
  <CtaBand />
</BaseLayout>

<style>
  /* Sections are one rhythm step apart; the closing band brings its own space above. */
  .page {
    display: grid;
    gap: var(--space-20);
    padding-block-start: var(--space-20);
  }
  .content {
    margin-block-start: var(--space-8);
  }
  .faq {
    display: grid;
    gap: var(--space-6);
  }
  ul {
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
  @media (min-width: 48rem) {
    .faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .page {
      gap: var(--space-32);
    }
  }
</style>
