---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactFallback from '../../components/ContactFallback.astro';
import { contactCopy as copy } from '../../content/contact';
import { newTabHint, primaryCta } from '../../content/navigation';
import { newTabAttrs } from '../../lib/config/booking';
---

<BaseLayout title={copy.title} description={copy.description}>
  <article
    class="container section"
    itemscope
    itemtype="https://schema.org/ContactPage"
  >
    <meta itemprop="name" content={copy.heading} />
    <meta itemprop="description" content={copy.intro} />
    <PageHeader title={copy.heading} lede={copy.intro} />
    {primaryCta.newTab && (
      <p class="booking">
        <a
          class="standalone"
          href={primaryCta.href}
          {...newTabAttrs(primaryCta)}
          data-booking-link
        >
          {primaryCta.label}
          <span class="visually-hidden"> ({newTabHint})</span>
        </a>
      </p>
    )}
    <div class="contact-grid">
      <ContactForm />
      <aside class="contact-next" aria-labelledby="contact-next-title">
        <h2 id="contact-next-title">{copy.next}</h2>
        <ol>
          {copy.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <ContactFallback />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .booking {
    margin-block: var(--space-6) 0;
  }
  .contact-grid {
    display: grid;
    gap: var(--space-8);
    margin-block-start: var(--space-10);
  }
  .contact-grid > * {
    min-inline-size: 0;
  }
  .contact-next {
    align-self: start;
    background: var(--color-light-surface);
    padding: var(--space-6);
    border: 1px solid var(--color-light-control-border);
    border-radius: var(--radius-sm);
  }
  .contact-next ol {
    padding-inline-start: var(--space-6);
    margin-block: var(--space-6);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
  .contact-grid:has([data-contact-success]:not([hidden])) .contact-next {
    display: none;
  }
</style>
