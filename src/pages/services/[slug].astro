---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import AiDemo from '../../components/sections/AiDemo.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import ExampleScreen from '../../components/ui/ExampleScreen.astro';
import ServiceToken from '../../components/ui/ServiceToken.astro';
import { aiDemo } from '../../content/ai-demo';
import { marqueeCopy } from '../../content/examples';
import { sectionLabels } from '../../content/sections';
import {
  services,
  servicesOverview,
  type Service,
} from '../../content/services';
import { breadcrumbJsonLd } from '../../lib/seo/breadcrumbs';
import { siteConfig, siteOrigin } from '../../../site.config';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;
const { example } = service;
const ancestors = [
  { label: sectionLabels.home, href: '/' },
  { label: sectionLabels.services, href: servicesOverview.href },
];
const shotSizes = '(min-width: 64rem) 340px, (min-width: 48rem) 28vw, 85vw';
---

<BaseLayout
  title={`${service.seo.title} | ${siteConfig.brand}`}
  description={service.seo.description}
  structuredData={breadcrumbJsonLd(
    [...ancestors, { label: service.label, href: service.href }],
    siteOrigin,
  )}
>
  <div class="container section">
    <PageHeader
      title={service.intro.heading}
      lede={service.intro.lede}
      breadcrumbs={ancestors}
      current={service.label}
    >
      <p slot="before-title" class="service-name">
        <ServiceToken service={service.key} size="lg" />
        <span>{service.label}</span>
      </p>
    </PageHeader>
  </div>

  <div class="container">
    <section class="row" aria-labelledby="what-title">
      <h2 id="what-title">{service.what.heading}</h2>
      <div class="row-body">
        <p>{service.what.body}</p>
        <ul>{service.what.bullets.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>
    <section class="row" aria-labelledby="process-title">
      <h2 id="process-title">{service.process.heading}</h2>
      <div class="row-body">
        <ol>{service.process.steps.map((step) => <li>{step}</li>)}</ol>
      </div>
    </section>
    <section class="row" aria-labelledby="for-title">
      <h2 id="for-title">{service.audienceBlock.heading}</h2>
      <div class="row-body">
        <p>{service.audienceBlock.body}</p>
        {service.audienceBlock.note && <p>{service.audienceBlock.note}</p>}
      </div>
    </section>
  </div>

  {example.demo && <AiDemo copy={{ ...aiDemo, heading: example.heading }} />}

  <section
    class="container section"
    aria-labelledby={example.demo ? 'example-caption' : 'example-title'}
  >
    {!example.demo && <h2 id="example-title">{example.heading}</h2>}
    <p class="caption" id="example-caption">{example.caption}</p>
    {example.proof && <p>{example.proof}</p>}
    <p class="note">{marqueeCopy.note}</p>
    <div class="gallery">
      {
        example.screens.map((id) => (
          <ExampleScreen {id} sizes={shotSizes} lift />
        ))
      }
    </div>
  </section>

  <CtaBand content={service.closing} cta={service.cta} />
</BaseLayout>

<style>
  .service-name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    font-weight: var(--font-weight-semibold);
  }
  .row {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-block-start: 1px solid var(--color-light-hairline);
  }
  .row-body {
    min-inline-size: 0;
    max-inline-size: var(--layout-text);
  }
  ul,
  ol {
    padding-inline-start: var(--space-6);
  }
  p + ul {
    margin-block-start: var(--space-4);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
  .caption {
    max-inline-size: var(--layout-text);
    font-size: var(--font-size-lead);
    line-height: var(--font-line-height-snug);
  }
  .note {
    color: var(--color-light-text-muted);
    font-size: var(--font-size-small);
  }
  /* Columns, not a grid: the screens differ in height and count per service. */
  .gallery {
    columns: 1;
    column-gap: var(--space-3);
    margin-block-start: var(--space-6);
    padding: var(--space-3);
    border-radius: var(--radius-xl);
    background: var(--color-light-surface);
  }
  .gallery > :global(.shot) {
    break-inside: avoid;
    margin-block-end: var(--space-3);
  }
  /* Qualifications must grow the card when visitors enlarge text. */
  .gallery :global(figcaption) {
    position: static;
    inline-size: fit-content;
    margin: var(--space-2);
  }
  @media (min-width: 48rem) {
    .gallery {
      columns: 3;
      column-gap: var(--space-6);
      padding: var(--space-8);
      border-radius: var(--radius-xxl);
    }
    .gallery > :global(.shot) {
      margin-block-end: var(--space-6);
    }
  }
  @media (min-width: 64rem) {
    .row {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-8);
      padding-block: var(--space-12);
    }
  }
</style>
