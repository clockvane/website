---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import ServiceScene from '../../components/sections/ServiceScene.astro';
import ProcessSteps from '../../components/sections/ProcessSteps.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { services } from '../../content/services';
import {
  servicePages,
  servicePageLabels as labels,
  servicesIntro,
} from '../../content/service-pages';
import { siteConfig, siteOrigin } from '../../../site.config';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}
interface Props {
  service: (typeof services)[number];
}
const { service } = Astro.props;
const copy = servicePages[service.slug];
const breadcrumbs = [
  { label: labels.home, href: '/' },
  { label: servicesIntro.heading, href: '/services/' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.label,
      description: copy.description,
      url: new URL(service.href, siteOrigin).href,
      provider: { '@type': 'Organization', name: siteConfig.brand },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...breadcrumbs,
        { label: service.label, href: service.href },
      ].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: new URL(item.href, siteOrigin).href,
      })),
    },
  ],
};
const related = services.filter((item) => copy.related.includes(item.slug));
---

<BaseLayout
  title={`${copy.seo} | ${siteConfig.brand}`}
  description={copy.description}
  motion
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')}
  />
  <article>
    <div class="container section">
      <PageHeader
        title={service.label}
        lede={copy.intro}
        {breadcrumbs}
        action={siteConfig.primaryCta}
      />
    </div>
    <div class="container section"><ServiceScene variant={service.slug} /></div>
    <section class="container section" aria-labelledby="service-what">
      <div class="measure">
        <h2 id="service-what">{labels.what}</h2><p>{copy.what}</p>
      </div>
    </section>
    <section class="container section" aria-labelledby="service-audience">
      <div class="measure">
        <h2 id="service-audience">{labels.audience}</h2><p>{copy.audience}</p>
      </div>
    </section>
    <section class="container section" aria-labelledby="service-deliverables">
      <div class="measure">
        <h2 id="service-deliverables">{labels.deliverables}</h2><ul>
          {copy.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
    <section class="container section" aria-labelledby="service-process">
      <h2 id="service-process">{labels.process}</h2><ProcessSteps
        steps={copy.process.map((body) => ({ title: body, body: '' }))}
      />{copy.note && <p>{copy.note}</p>}
    </section>
    <section class="container section" aria-labelledby="service-needs">
      <div class="measure">
        <h2 id="service-needs">{labels.needs}</h2><ul>
          {copy.needs.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
    <section class="container section" aria-labelledby="service-related">
      <h2 id="service-related">{labels.related}</h2><ul>
        {
          related.map((item) => (
            <li>
              <a class="standalone" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
  <CtaBand />
</BaseLayout>

<style>
  ul {
    margin-block: var(--space-4);
    padding-inline-start: var(--space-6);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
</style>
