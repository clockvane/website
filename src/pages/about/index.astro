---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { aboutCopy as copy } from '../../content/about';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="container page section">
    <PageHeader title={copy.heading} lede={copy.lede} />
    <section class="measure" aria-labelledby="about-expertise">
      <h2 id="about-expertise">{copy.expertise.heading}</h2>
      <p>{copy.expertise.body}</p>
      <a class="standalone" href={copy.expertise.link.href}>
        {copy.expertise.link.label}
      </a>
    </section>
    <section class="measure" aria-labelledby="about-proof">
      <h2 id="about-proof">{copy.proof.heading}</h2>
      <p>{copy.proof.body}</p>
    </section>
  </div>
  <CtaBand />
</BaseLayout>

<style>
  /* Hero top from the section tokens; .section supplies the bottom, so the band is two steps away. */
  .page {
    display: grid;
    gap: calc(2 * var(--section-content));
    padding-block-start: var(--section-hero);
  }
  section > .standalone {
    margin-block-start: var(--space-2);
  }
  @media (min-width: 64rem) {
    .page {
      padding-block-start: var(--section-hero-wide);
      gap: calc(2 * var(--section-content-wide));
    }
  }
</style>
