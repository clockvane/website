---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { aboutCopy as copy } from '../../content/about';
---

<BaseLayout title={copy.title} description={copy.description}>
  <div class="container page">
    <PageHeader title={copy.heading} lede={copy.lede} />
    <section class="measure" aria-labelledby="about-who">
      <h2 id="about-who">{copy.who.heading}</h2>
      <p>{copy.who.body}</p>
    </section>
    <section class="measure" aria-labelledby="about-expertise">
      <h2 id="about-expertise">{copy.expertise.heading}</h2>
      <p>{copy.expertise.body}</p>
      <a class="standalone" href={copy.expertise.link.href}>
        {copy.expertise.link.label}
      </a>
    </section>
    <section class="measure" aria-labelledby="about-proof">
      <h2 id="about-proof">{copy.proof.heading}</h2>
      <p>{copy.proof.body}</p>
      {
        copy.proof.links.map((link) => (
          <a class="standalone" href={link.href}>
            {link.label}
          </a>
        ))
      }
      <p>{copy.proof.linksPlaceholder}</p>
    </section>
  </div>
  <CtaBand />
</BaseLayout>

<style>
  /* Sections are one rhythm step apart; the closing band brings its own space above. */
  .page {
    display: grid;
    gap: var(--space-20);
    padding-block-start: var(--space-20);
  }
  section > .standalone {
    margin-block-start: var(--space-2);
  }
  @media (min-width: 64rem) {
    .page {
      gap: var(--space-32);
    }
  }
</style>
