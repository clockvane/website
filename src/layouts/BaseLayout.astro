---
import { siteConfig, siteOrigin } from '../../site.config';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/base.css';
import '../styles/utilities.css';
// Generated media rules come last so responsive classes override component defaults.
import '../styles/tokens.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, siteOrigin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', siteOrigin).href} />
    <meta
      property="og:image:alt"
      content="A workflow connecting two tools through a human checkpoint."
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', siteOrigin).href} />
    <link
      rel="preload"
      href="/fonts/public-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip standalone" href="#main">Skip to main content</a>
    <SiteHeader {currentPath} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter {currentPath} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: var(--space-4);
    transform: translateY(-200%);
    z-index: var(--elevation-skip-link);
    padding: var(--space-4);
    background: var(--color-light-background);
  }
  .skip:focus {
    transform: none;
  }
</style>
