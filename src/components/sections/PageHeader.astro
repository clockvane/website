---
import { sectionLabels } from '../../content/sections';
interface Props {
  title: string;
  lede?: string;
  breadcrumbs?: readonly { label: string; href: string }[];
  /** The current breadcrumb, when the page's name differs from its h1. Defaults to `title`. */
  current?: string;
  action?: { label: string; href: string };
}
const { title, lede, breadcrumbs = [], current = title, action } = Astro.props;
---

<header class="page-header measure">
  {breadcrumbs.length > 0 && (
    <nav aria-label={sectionLabels.breadcrumb}>
      <ol>
        {breadcrumbs.map((item) => (
          <li>
            <a class="standalone" href={item.href}>
              {item.label}
            </a>
            <span aria-hidden="true">/</span>
          </li>
        ))}
        <li aria-current="page">{current}</li>
      </ol>
    </nav>
  )}
  <slot name="before-title" />
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  {action && (
    <div class="actions">
      <a class="pill pill--primary" href={action.href}>
        {action.label}
      </a>
    </div>
  )}
</header>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: var(--space-2);
    font-size: var(--font-size-small);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lede {
    font-size: var(--font-size-lead);
  }
  .actions {
    margin-block-start: var(--space-6);
    padding: var(--space-2);
  }
</style>
