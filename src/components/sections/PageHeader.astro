---
import { sectionLabels } from '../../content/sections';
interface Props {
  title: string;
  lede?: string;
  breadcrumbs?: readonly { label: string; href: string }[];
  action?: { label: string; href: string };
}
const { title, lede, breadcrumbs = [], action } = Astro.props;
---

<header class="page-header measure">
  {
    breadcrumbs.length > 0 && (
      <nav aria-label={sectionLabels.breadcrumb}>
        <ol>
          {breadcrumbs.map((item) => (
            <li>
              <a class="standalone" href={item.href}>
                {item.label}
              </a>
              <span aria-hidden="true">/</span>
            </li>
          ))}
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
    )
  }
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  {
    action && (
      <div class="actions">
        <a class="button standalone" href={action.href}>
          {action.label}
        </a>
      </div>
    )
  }
</header>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-0) var(--space-0) var(--space-6);
    padding: var(--space-2);
    font-size: var(--font-size-small);
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lede {
    font-size: var(--font-size-lede);
  }
  .actions {
    margin-block-start: var(--space-6);
    padding: var(--space-2);
  }
</style>
