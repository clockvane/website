---
import { workflowIllustrations } from '../../content/workflow-illustrations';

interface Props {
  variant: keyof typeof workflowIllustrations;
  /** Equivalent prose; use the service-specific copy on process automation. */
  description?: string;
}
const { variant, description = workflowIllustrations[variant].description } =
  Astro.props;
const content = workflowIllustrations[variant];
---

<figure class="workflow-illustration" data-variant={variant}>
  <div class="illustration-canvas" aria-hidden="true">
    {
      'panels' in content ? (
        <div class="illustration-comparison">
          {content.panels.map((panel) => (
            <div>
              <p class="panel-label">{panel.label}</p>
              <ol class="pipeline">
                {content.tools.map((label, index) => (
                  <li>
                    {index > 0 && (
                      <svg
                        class="connector"
                        viewBox="0 0 24 40"
                        focusable="false"
                      >
                        <path d="M12 0V38m-6-7 6 7 6-7" />
                      </svg>
                    )}
                    <div class="node">
                      {panel.manual && (
                        <svg
                          class="person"
                          viewBox="0 0 24 24"
                          focusable="false"
                        >
                          <circle cx="12" cy="5" r="3" />
                          <path d="M5 22v-6a7 7 0 0 1 14 0v6M12 12v10" />
                        </svg>
                      )}
                      <span>{label}</span>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      ) : (
        <>
          <ol class="pipeline">
            {content.steps.map((label, index) => (
              <li>
                {index > 0 && (
                  <svg class="connector" viewBox="0 0 24 40" focusable="false">
                    <path d="M12 0V38m-6-7 6 7 6-7" />
                  </svg>
                )}
                <div class="node">{label}</div>
              </li>
            ))}
          </ol>
          <ul class="outcomes">
            {content.outcomes.map((outcome) => (
              <li>
                <svg class="branch" viewBox="0 0 40 24" focusable="false">
                  <path d="M0 12H38m-7-6 7 6-7 6" />
                </svg>
                <div class="outcome">
                  {'path' in outcome && (
                    <p class="path-label">{outcome.path}</p>
                  )}
                  <div class="node">{outcome.label}</div>
                </div>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
  <figcaption>{description}</figcaption>
</figure>

<style>
  .workflow-illustration {
    margin: var(--space-0);
    padding: var(--space-4);
    border: var(--stroke-border) solid var(--color-dark-border);
    border-radius: var(--radius-small);
    background: var(--color-dark-surface);
    color: var(--color-dark-text);
    font-size: var(--font-size-small);
  }
  .illustration-canvas {
    container: illustration / inline-size;
  }
  .illustration-comparison {
    display: grid;
    grid-template-columns: var(--illustration-columns, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .panel-label,
  .path-label {
    font-weight: var(--font-weight-semibold);
    margin-block-end: var(--space-2);
  }
  .pipeline,
  .outcomes {
    list-style: none;
    margin: var(--space-0);
    padding: var(--space-0);
  }
  .node {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-inline-size: 0;
    min-block-size: var(--size-control);
    padding: var(--space-2);
    border: var(--stroke-diagram) solid var(--color-dark-border);
    border-radius: var(--radius-small);
    background: var(--color-dark-background);
    text-align: center;
  }
  svg {
    display: block;
    fill: none;
    stroke: var(--color-dark-action);
    stroke-width: var(--stroke-diagram);
  }
  .connector {
    inline-size: var(--size-icon);
    block-size: var(--space-10);
    margin-inline: auto;
  }
  .person {
    flex: none;
    inline-size: var(--size-icon);
    block-size: var(--size-icon);
    stroke: var(--color-dark-text);
  }
  .outcomes {
    margin-inline-start: var(--space-4);
    border-inline-start: var(--stroke-diagram) solid var(--color-dark-action);
  }
  .outcomes > li {
    display: flex;
    align-items: center;
    padding-block-start: var(--space-6);
  }
  .branch {
    flex: none;
    inline-size: var(--space-6);
    block-size: var(--size-icon);
  }
  .outcome {
    flex: 1;
    min-inline-size: 0;
  }
  figcaption {
    margin-block-start: var(--space-4);
  }
  @media (forced-colors: active) {
    svg {
      stroke: CanvasText;
    }
    .outcomes {
      border-color: CanvasText;
    }
  }
</style>
