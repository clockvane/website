---
import { services } from '../../content/services';
import { sectionLabels } from '../../content/sections';
interface Props {
  variant?: 'home' | 'overview';
}
const { variant = 'home' } = Astro.props;
const Heading = variant === 'home' ? 'h3' : 'h2';
---

<div class:list={['service-list', `services-${variant}`]}>
  {
    services.map((service, index) => (
      <section
        id={variant === 'overview' ? service.slug : undefined}
        class="service-row"
      >
        <p class="label">{String(index + 1).padStart(2, '0')}</p>
        <Heading>{service.label}</Heading>
        <p>{service.summary}</p>
        {variant === 'overview' && (
          <div class="service-work">
            <h3>{sectionLabels.typicalWork}</h3>
            <ul>
              {service.what.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        <a class="standalone" href={service.href}>
          {service.linkLabel}
        </a>
      </section>
    ))
  }
</div>

<style>
  .service-row {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--color-light-control-border);
  }
  .service-row:last-child {
    border-block-end: 1px solid var(--color-light-control-border);
  }
  .service-row > * {
    min-inline-size: 0;
  }
  a {
    justify-self: start;
    margin-block: var(--space-2);
  }
  ul {
    padding-inline-start: var(--space-6);
    margin-block-start: var(--space-4);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
</style>
