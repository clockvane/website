---
import { services } from '../../content/services';
import { sectionLabels } from '../../content/sections';
import { serviceScenes, sceneCopy } from '../../content/service-scenes';
import ServiceScene from './ServiceScene.astro';
import SceneReplay from '../ui/SceneReplay.astro';
import { servicePages, overviewWork } from '../../content/service-pages';
interface Props {
  variant?: 'home' | 'overview';
}
const { variant = 'home' } = Astro.props;
const Heading = variant === 'home' ? 'h3' : 'h2';
---

<div class:list={['service-list', `services-${variant}`]}>
  {
    services.map((service, index) => (
      <section
        id={variant === 'overview' ? service.slug : undefined}
        class="service-row"
        data-scene
        data-duration="1800"
      >
        <div class="service-copy">
          <p class="label">
            {String(index + 1).padStart(2, '0')} /{' '}
            {serviceScenes[service.slug].category}
          </p>
          <Heading>{service.label}</Heading>
          <p>
            {variant === 'overview'
              ? servicePages[service.slug].summary
              : service.summary}
          </p>
          <p>
            {sceneCopy.audience}
            {serviceScenes[service.slug].audience}
          </p>
          {variant === 'overview' && (
            <div class="service-work">
              <p>{servicePages[service.slug].workflow}</p>
              <h3>{sectionLabels.typicalWork}</h3>
              <ul>
                {(overviewWork[service.slug] ?? service.work).map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
          <div class="service-actions">
            <a class="standalone" href={service.href}>
              {service.linkLabel}
            </a>
            <SceneReplay name={`Replay example: ${service.label}`} />
          </div>
        </div>
        <ServiceScene variant={service.slug} standalone={false} />
      </section>
    ))
  }
</div>
<p>{sceneCopy.note}</p>

<style>
  .service-row {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-6);
    border-block-start: var(--stroke-border) solid var(--color-dark-border);
  }
  .service-row:last-child {
    border-block-end: var(--stroke-border) solid var(--color-dark-border);
  }
  .service-row > * {
    min-inline-size: 0;
  }
  h3 + p {
    margin-block-start: var(--space-4);
  }
  a {
    margin-block: var(--space-2);
  }
  .service-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }
  .service-work,
  .label + h2,
  .label + h3 {
    margin-block-start: var(--space-4);
  }
  ul {
    padding-inline-start: var(--space-6);
    margin-block-start: var(--space-4);
  }
  li + li {
    margin-block-start: var(--space-3);
  }
</style>
