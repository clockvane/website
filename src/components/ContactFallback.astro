---
import { siteConfig } from '../../site.config';
import { publicDetails } from '../lib/config/public-details';
import { contactCopy as copy } from '../content/contact';
const { email, phones } = publicDetails(siteConfig);
---

{email && (
  <p>
    {copy.fallback}{' '}
    <a class="standalone" href={`mailto:${email}`}>
      {email}
    </a>
    .
  </p>
)}
{phones.length > 0 && (
  <p>
    {copy.call}{' '}
    {phones.map((phone, index) => (
      <>
        {index > 0 && ` ${copy.callJoin} `}
        <a class="standalone" href={phone.href}>
          {phone.label}
        </a>
      </>
    ))}
    .
  </p>
)}
