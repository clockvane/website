---
import ResultPanel from './sections/ResultPanel.astro';
import { contactCopy as copy } from '../content/contact';
import ContactFallback from './ContactFallback.astro';
interface Props {
  kind: 'thanks' | 'error';
  inline?: boolean;
}
const { kind, inline = false } = Astro.props;
const NextHeading = inline ? 'h3' : 'h2';
const result = copy[kind];
---

{kind === 'thanks' ? (
  <ResultPanel
    title={result.heading}
    body={result.body}
    {inline}
    actions={[
      { label: copy.how, href: '/how-we-work/' },
      { label: copy.home, href: '/' },
    ]}
  >
    <NextHeading class="next">{copy.next}</NextHeading>
    <p>{copy.thanks.nextBody}</p>
  </ResultPanel>
) : (
  <ResultPanel title={result.heading} body={result.body} {inline}>
    <ContactFallback />
    <a class="pill pill--primary back" href="/contact/">
      {copy.back}
    </a>
  </ResultPanel>
)}

<style>
  .next,
  .back {
    margin-block-start: var(--space-6);
  }
</style>
