---
import { siteConfig } from '../../site.config';
import { company, services } from '../content/navigation';
import { footerLine, footerLocation } from '../content/site';
import { publicDetails } from '../lib/config/public-details';
import NavLinks from './ui/NavLinks.astro';
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const details = publicDetails(siteConfig);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a
        class="wordmark standalone"
        href="/"
        aria-label={`${siteConfig.brand} home`}>{siteConfig.brand}</a
      >
      <p>{siteConfig.tagline}</p>
      <p>{footerLine}</p>
      {
        details.email && (
          <a class="standalone" href={`mailto:${details.email}`}>
            {details.email}
          </a>
        )
      }
      {
        details.phone && (
          <a class="standalone" href={`tel:${details.phone}`}>
            {details.phone}
          </a>
        )
      }
    </div>
    <nav aria-labelledby="footer-services">
      <h2 id="footer-services">Services</h2>
      <NavLinks links={services} {currentPath} />
    </nav>
    <nav aria-labelledby="footer-company">
      <h2 id="footer-company">Company</h2>
      <NavLinks
        links={[
          ...company,
          { href: '/contact/', label: 'Contact' },
          { href: '/privacy/', label: 'Privacy notice' },
        ]}
        {currentPath}
      />
    </nav>
  </div>
  <div class="container footer-base">
    <p>© {new Date().getUTCFullYear()} {siteConfig.brand}</p>
    <p>{footerLocation}</p>
    {
      details.socials.length > 0 && (
        <nav aria-label="Social links">
          <NavLinks
            links={details.socials.map(({ label, href }) => ({
              label: label === 'github' ? 'GitHub' : 'LinkedIn',
              href,
            }))}
            {currentPath}
          />
        </nav>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    background: var(--color-dark-canvas);
    color: var(--color-dark-text);
  }
  .site-footer :global(:focus-visible) {
    outline-color: var(--color-dark-focus);
  }
  .site-footer a,
  .site-footer :global(.nav-list a) {
    color: var(--color-dark-link);
    text-decoration: none;
    font-weight: var(--font-weight-regular);
  }
  .site-footer a:hover,
  .site-footer :global(.nav-list a:hover) {
    color: var(--color-dark-link-hover);
    text-decoration: underline;
  }
  .footer-grid {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-8);
  }
  .footer-grid > * {
    min-inline-size: 0;
  }
  .wordmark {
    font-size: var(--font-size-lead);
    letter-spacing: var(--font-tracking-heading);
  }
  .site-footer .wordmark {
    font-weight: var(--font-weight-display);
  }
  .footer-brand p {
    margin-block-start: var(--space-2);
    max-inline-size: 24rem;
    color: var(--color-dark-text-muted);
  }
  h2 {
    margin-block-end: var(--space-2);
    color: var(--color-dark-text-muted);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5) var(--space-8);
    color: var(--color-dark-text-muted);
    font-size: var(--font-size-small);
  }
  .footer-base::before {
    content: '';
    flex-basis: 100%;
    block-size: 1px;
    background: var(--color-dark-hairline);
  }
  .footer-base p {
    margin-block-start: 0;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .site-footer {
      border-radius: var(--radius-xxl) var(--radius-xxl) 0 0;
    }
  }
</style>
