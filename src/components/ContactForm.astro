---
import { siteConfig } from '../../site.config';
import { contactCopy as copy } from '../content/contact';
import { fieldNames, limits, serviceOptions } from '../lib/contact/schema';
import ContactFallback from './ContactFallback.astro';
import ContactResult from './ContactResult.astro';
---

<div data-contact>
  <div data-contact-fields>
    <h2>{copy.formHeading}</h2>
    <section
      class="feedback"
      data-errors
      hidden
      tabindex="-1"
      aria-labelledby="contact-errors-title"
    >
      <h3 id="contact-errors-title">{copy.summary}</h3>
      <p>{copy.summaryIntro}</p>
      <ul></ul>
    </section>
    <section
      class="feedback"
      data-failure
      hidden
      tabindex="-1"
      aria-labelledby="contact-failure-title"
    >
      <h3 id="contact-failure-title">{copy.error.heading}</h3>
      <p data-failure-message></p>
      <ContactFallback />
    </section>
    <p class="status" role="status" data-status></p>
    <form
      action={siteConfig.contact.endpoint}
      method="post"
      enctype="application/x-www-form-urlencoded"
    >
      {
        fieldNames.map((field) =>
          field === 'service' ? (
            <fieldset
              class="field"
              role="radiogroup"
              aria-required="true"
              aria-describedby="service-hint"
              data-field="service"
            >
              <legend class="field-label">{copy.fields.service.label}</legend>
              <p class="hint" id="service-hint">
                {copy.fields.service.hint}
              </p>
              <div class="options">
                {serviceOptions.map(({ value, label }, index) => (
                  <label class="option">
                    <input
                      id={index === 0 ? 'contact-service' : undefined}
                      name="service"
                      type="radio"
                      value={value}
                      required
                    />
                    {label}
                  </label>
                ))}
              </div>
              <p class="field-error" id="service-error" hidden />
            </fieldset>
          ) : (
            <div class="field">
              <label class="field-label" for={`contact-${field}`}>
                {copy.fields[field].label}
              </label>
              <p class="hint" id={`${field}-hint`}>
                {copy.fields[field].hint}
              </p>
              {field === 'message' ? (
                <textarea
                  class="control"
                  id={`contact-${field}`}
                  name={field}
                  required
                  minlength="10"
                  maxlength={limits[field]}
                  aria-describedby={`${field}-hint`}
                  data-field={field}
                />
              ) : (
                <input
                  class="control"
                  id={`contact-${field}`}
                  name={field}
                  type="text"
                  autocomplete={field === 'name' ? 'name' : undefined}
                  required
                  maxlength={limits[field]}
                  aria-describedby={`${field}-hint`}
                  data-field={field}
                />
              )}
              <p class="field-error" id={`${field}-error`} hidden />
            </div>
          ),
        )
      }
      <div hidden aria-hidden="true">
        <input
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          aria-label="Website"
        />
        <input name="started" type="hidden" value="" />
      </div>
      <button class="pill pill--primary" type="submit">{copy.send}</button>
      <p class="hint">
        {copy.privacy}{' '}
        <a class="standalone" href="/privacy/">{copy.privacyLink}</a>.
      </p>
    </form>
  </div>
  <div data-contact-success hidden><ContactResult kind="thanks" inline /></div>
</div>

<script>
  import '../scripts/contact';
</script>

<style>
  form {
    margin-block-start: var(--space-6);
  }
  .field {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
  }
  fieldset {
    min-inline-size: 0;
    margin-inline: 0;
    padding: 0;
    border: 0;
  }
  .field-label {
    padding: 0;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-small);
  }
  legend {
    margin-block-end: var(--space-2);
  }
  .option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--layout-tap);
    cursor: pointer;
  }
  .option input {
    flex: none;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    margin: 0;
    accent-color: var(--color-light-action);
    cursor: inherit;
  }
  fieldset:disabled .option {
    color: var(--color-light-disabled-text);
    cursor: not-allowed;
  }
  .hint {
    color: var(--color-light-text-muted);
    font-size: var(--font-size-small);
    margin-block-start: 0;
  }
  .control {
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: var(--layout-tap);
    padding: var(--space-3);
    border: 1px solid var(--color-light-control-border);
    border-radius: var(--radius-md);
    background: var(--color-light-canvas);
    color: var(--color-light-text);
    font: inherit;
  }
  textarea {
    min-block-size: var(--space-40);
    resize: vertical;
  }
  .control:hover,
  .control:active {
    border-color: var(--color-light-text);
  }
  .control:read-only {
    background: var(--color-light-disabled-fill);
    color: var(--color-light-disabled-text);
  }
  .control[aria-invalid='true'] {
    border-color: var(--color-light-error);
  }
  .field-error,
  .feedback {
    color: var(--color-light-error);
  }
  .feedback {
    margin-block: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-light-error);
    border-radius: var(--radius-sm);
  }
  .feedback ul {
    padding-inline-start: var(--space-6);
  }
  .feedback a {
    display: inline-flex;
    min-block-size: var(--layout-tap);
    align-items: center;
  }
  .status:empty {
    display: none;
  }
  button {
    font-family: inherit;
    cursor: pointer;
  }
  button[aria-disabled='true'] {
    cursor: wait;
  }
  form > .hint {
    margin-block-start: var(--space-4);
  }
</style>
