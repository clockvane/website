{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "availableModels": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",
      "TodoWrite",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(corepack *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(xargs *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(ps *)",
      "Bash(pgrep *)",
      "Bash(lsof *)",
      "Bash(true)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(date *)",
      "Bash(du *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(rm *)",
      "Bash(chmod +x *)",
      "Bash(curl -s *)",
      "Bash(curl -sI *)",
      "Bash(curl -I *)",
      "Bash(curl --head *)",
      "Bash(kill *)",
      "Bash(sleep *)",
      "Bash(timeout *)",
      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(docker images *)",
      "Bash(docker ps *)",
      "Bash(docker stop *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker image prune *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init -backend=false *)",
      "Bash(actionlint *)",
      "Bash(actionlint)",
      "Bash(shellcheck *)",
      "Bash(hadolint *)",
      "Bash(agentops/bin/post-review *)",
      "Bash(./agentops/bin/post-review *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./agentops/**)",
      "Edit(./.codex/**)",
      "Edit(./AGENTS.md)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./docs/product/BRIEF.md)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin master*)",
      "Bash(git config --global *)",
      "Bash(gh pr merge*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh ruleset*)",
      "Bash(gh auth*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh workflow disable*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state*)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(bq *)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(kubectl *)",
      "Bash(helm *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(wrangler *)",
      "Bash(firebase *)",
      "Bash(npm publish*)",
      "Bash(npm login*)",
      "Bash(npm adduser*)",
      "Bash(npm token*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agentops/hooks/guard_bash.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agentops/hooks/protect_paths.py\""
          }
        ]
      }
    ]
  }
}
