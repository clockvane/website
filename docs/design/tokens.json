{
  "$description": "Workshop ledger, issue #45. Light theme and local inverse bands only; dark mode deferred. See design-system.md for allowed pairings and component contracts.",
  "$extensions": {
    "org.design.audit": {
      "format": "https://www.designtokens.org/tr/2025.10/format/",
      "contrast": [
        { "foreground": "palette.ink", "background": "palette.paper", "ratio": 13.97, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.ink", "background": "palette.paperDeep", "ratio": 12.09, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.inkSoft", "background": "palette.paper", "ratio": 6.77, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.inkSoft", "background": "palette.paperDeep", "ratio": 5.86, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.brass", "background": "palette.paper", "ratio": 6.07, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.brass", "background": "palette.paperDeep", "ratio": 5.26, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.navy", "background": "palette.paper", "ratio": 10.12, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.navy", "background": "palette.paperDeep", "ratio": 8.76, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.brassLight", "background": "palette.navy", "ratio": 7.09, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.error", "background": "palette.paper", "ratio": 7.82, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.error", "background": "palette.paperDeep", "ratio": 6.77, "textMinimum": 4.5, "uiMinimum": 3 }
      ],
      "fontBudget": { "families": 2, "files": 2, "woff2Bytes": 84916, "maximumBytes": 100000, "evidence": "design-system.md#font-delivery-budget" }
    }
  },
  "palette": {
    "$type": "color",
    "paper": { "$value": { "colorSpace": "srgb", "components": [0.964706, 0.949020, 0.917647], "alpha": 1, "hex": "#F6F2EA" } },
    "paperDeep": { "$value": { "colorSpace": "srgb", "components": [0.913725, 0.886275, 0.827451], "alpha": 1, "hex": "#E9E2D3" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.105882, 0.141176, 0.200000], "alpha": 1, "hex": "#1B2433" } },
    "inkSoft": { "$value": { "colorSpace": "srgb", "components": [0.290196, 0.333333, 0.396078], "alpha": 1, "hex": "#4A5565" } },
    "brass": { "$value": { "colorSpace": "srgb", "components": [0.541176, 0.294118, 0.078431], "alpha": 1, "hex": "#8A4B14" } },
    "navy": { "$value": { "colorSpace": "srgb", "components": [0.176471, 0.231373, 0.321569], "alpha": 1, "hex": "#2D3B52" } },
    "brassLight": { "$value": { "colorSpace": "srgb", "components": [0.909804, 0.788235, 0.560784], "alpha": 1, "hex": "#E8C98F" } },
    "error": { "$value": { "colorSpace": "srgb", "components": [0.541176, 0.156863, 0.121569], "alpha": 1, "hex": "#8A281F" } }
  },
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "{palette.paper}" },
      "surface": { "$value": "{palette.paperDeep}" },
      "text": { "$value": "{palette.ink}" },
      "muted": { "$value": "{palette.inkSoft}" },
      "border": { "$value": "{palette.inkSoft}" },
      "link": { "$value": "{palette.brass}" },
      "linkHover": { "$value": "{palette.ink}" },
      "focus": { "$value": "{palette.brass}" },
      "action": { "$value": "{palette.brass}" },
      "actionHover": { "$value": "{palette.navy}" },
      "actionActive": { "$value": "{palette.ink}" },
      "onAction": { "$value": "{palette.paper}" },
      "disabledFill": { "$value": "{palette.paperDeep}" },
      "disabledText": { "$value": "{palette.inkSoft}" },
      "error": { "$value": "{palette.error}" }
    },
    "inverse": {
      "background": { "$value": "{palette.navy}" },
      "text": { "$value": "{palette.paper}" },
      "muted": { "$value": "{palette.paperDeep}" },
      "border": { "$value": "{palette.brassLight}" },
      "link": { "$value": "{palette.brassLight}" },
      "linkHover": { "$value": "{palette.paper}" },
      "linkActive": { "$value": "{palette.paperDeep}" },
      "focus": { "$value": "{palette.brassLight}" },
      "action": { "$value": "{palette.brassLight}" },
      "actionHover": { "$value": "{palette.paper}" },
      "actionActive": { "$value": "{palette.paperDeep}" },
      "onAction": { "$value": "{palette.navy}" },
      "disabledFill": { "$value": "{palette.navy}" },
      "disabledText": { "$value": "{palette.paperDeep}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Newsreader", "Georgia", "serif"] },
      "body": { "$value": ["Public Sans", "Arial", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "small": { "$value": { "value": 1, "unit": "rem" } },
      "body": { "$value": { "value": 1.125, "unit": "rem" } },
      "lede": { "$value": { "value": 1.25, "unit": "rem" } },
      "h3": { "$value": { "value": 1.5, "unit": "rem" } },
      "h2Mobile": { "$value": { "value": 2, "unit": "rem" } },
      "h2Desktop": { "$value": { "value": 2.5, "unit": "rem" } },
      "h1Mobile": { "$value": { "value": 2.5, "unit": "rem" } },
      "h1Tablet": { "$value": { "value": 3, "unit": "rem" } },
      "h1Desktop": { "$value": { "value": 3.5, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    },
    "lineHeight": {
      "$type": "number",
      "body": { "$value": 1.6 },
      "heading": { "$value": 1.15 },
      "ui": { "$value": 1.5 }
    },
    "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "rem" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "14": { "$value": { "value": 3.5, "unit": "rem" } },
    "18": { "$value": { "value": 4.5, "unit": "rem" } },
    "24": { "$value": { "value": 6, "unit": "rem" } }
  },
  "layout": {
    "$type": "dimension",
    "content": { "$value": { "value": 75, "unit": "rem" } },
    "form": { "$value": { "value": 35, "unit": "rem" } },
    "result": { "$value": { "value": 40, "unit": "rem" } },
    "header": { "$value": { "value": 5, "unit": "rem" } },
    "anchorOffset": { "$value": { "value": 8, "unit": "rem" } },
    "stickyMinHeight": { "$value": { "value": 48, "unit": "rem" } },
    "measure": { "$type": "number", "$value": 65, "$description": "Character measure; CSS max-inline-size: calc(var(--layout-measure) * 1ch)." }
  },
  "breakpoint": {
    "$type": "dimension",
    "compactCta": { "$value": { "value": 30, "unit": "rem" } },
    "tablet": { "$value": { "value": 48, "unit": "rem" } },
    "desktop": { "$value": { "value": 64, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": { "value": 2.75, "unit": "rem" } },
    "control": { "$value": { "value": 3, "unit": "rem" } },
    "largeControl": { "$value": { "value": 3.5, "unit": "rem" } },
    "textarea": { "$value": { "value": 10, "unit": "rem" } },
    "icon": { "$value": { "value": 1.25, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "rem" } },
    "small": { "$value": { "value": 0.25, "unit": "rem" } }
  },
  "stroke": {
    "$type": "dimension",
    "border": { "$value": { "value": 1, "unit": "px" } },
    "diagram": { "$value": { "value": 1.5, "unit": "px" } },
    "focus": { "$value": { "value": 2, "unit": "px" } },
    "focusGap": { "$value": { "value": 2, "unit": "px" } }
  },
  "elevation": {
    "flat": { "$type": "shadow", "$description": "Zero geometry: no visible shadow; boundaries use stroke.border.", "$value": { "color": "{palette.ink}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "header": { "$type": "number", "$value": 10 },
    "skipLink": { "$type": "number", "$value": 20 }
  },
  "motion": {
    "none": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
    "interaction": { "$type": "duration", "$value": { "value": 240, "unit": "ms" } },
    "diagram": { "$type": "duration", "$value": { "value": 600, "unit": "ms" } },
    "easeOut": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
  }
}
