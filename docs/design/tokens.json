{
  "$description": "Dispatch field v2, issue #86; owner chose Concept C on PR #85. Dark-only; legacy light/inverse paths are compatibility aliases, not offered themes. See components.md, motion.md and contrast.md.",
  "$extensions": {
    "org.design.audit": {
      "format": "https://www.designtokens.org/tr/2025.10/format/",
      "version": 2,
      "themes": ["dark"],
      "contrast": [
        { "foreground": "palette.text", "background": "palette.canvas", "ratio": 18, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.muted", "background": "palette.canvas", "ratio": 11.67, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.ice", "background": "palette.canvas", "ratio": 15.18, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.iceHover", "background": "palette.canvas", "ratio": 17.41, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.line", "background": "palette.canvas", "ratio": 6.06, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.error", "background": "palette.canvas", "ratio": 11.36, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.text", "background": "palette.panel", "ratio": 15.43, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.muted", "background": "palette.panel", "ratio": 10.01, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.ice", "background": "palette.panel", "ratio": 13.01, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.iceHover", "background": "palette.panel", "ratio": 14.92, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.line", "background": "palette.panel", "ratio": 5.19, "textMinimum": 4.5, "uiMinimum": 3 },
        { "foreground": "palette.error", "background": "palette.panel", "ratio": 9.74, "textMinimum": 4.5, "uiMinimum": 3 }
      ],
      "fontBudget": {
        "families": 1,
        "files": 1,
        "woff2Bytes": 26832,
        "maximumBytes": 120000,
        "evidence": "components.md#type-and-layout"
      }
    }
  },
  "palette": {
    "$type": "color",
    "canvas": { "$value": { "colorSpace": "srgb", "components": [0.035294, 0.054902, 0.098039], "alpha": 1, "hex": "#090E19" } },
    "panel": { "$value": { "colorSpace": "srgb", "components": [0.07451, 0.121569, 0.196078], "alpha": 1, "hex": "#131F32" } },
    "text": { "$value": { "colorSpace": "srgb", "components": [0.956863, 0.968627, 1], "alpha": 1, "hex": "#F4F7FF" } },
    "muted": { "$value": { "colorSpace": "srgb", "components": [0.729412, 0.796078, 0.878431], "alpha": 1, "hex": "#BACBE0" } },
    "ice": { "$value": { "colorSpace": "srgb", "components": [0.709804, 0.929412, 1], "alpha": 1, "hex": "#B5EDFF" } },
    "iceHover": { "$value": { "colorSpace": "srgb", "components": [0.882353, 0.968627, 1], "alpha": 1, "hex": "#E1F7FF" } },
    "line": { "$value": { "colorSpace": "srgb", "components": [0.490196, 0.572549, 0.682353], "alpha": 1, "hex": "#7D92AE" } },
    "error": { "$value": { "colorSpace": "srgb", "components": [1, 0.705882, 0.670588], "alpha": 1, "hex": "#FFB4AB" } },
    "paper": { "$value": { "colorSpace": "srgb", "components": [0.035294, 0.054902, 0.098039], "alpha": 1, "hex": "#090E19" }, "$description": "Legacy concrete mirror of palette.canvas for direct hex consumers; migrate in #88." },
    "paperDeep": { "$value": { "colorSpace": "srgb", "components": [0.07451, 0.121569, 0.196078], "alpha": 1, "hex": "#131F32" }, "$description": "Legacy concrete mirror of palette.panel for direct hex consumers; migrate in #88." },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0.956863, 0.968627, 1], "alpha": 1, "hex": "#F4F7FF" }, "$description": "Legacy concrete mirror of palette.text for direct hex consumers; migrate in #88." },
    "inkSoft": { "$value": { "colorSpace": "srgb", "components": [0.729412, 0.796078, 0.878431], "alpha": 1, "hex": "#BACBE0" }, "$description": "Legacy concrete mirror of palette.muted for direct hex consumers; migrate in #88." },
    "brass": { "$value": { "colorSpace": "srgb", "components": [0.709804, 0.929412, 1], "alpha": 1, "hex": "#B5EDFF" }, "$description": "Legacy concrete mirror of palette.ice for direct hex consumers; migrate in #88." },
    "navy": { "$value": { "colorSpace": "srgb", "components": [0.882353, 0.968627, 1], "alpha": 1, "hex": "#E1F7FF" }, "$description": "Legacy concrete mirror of palette.iceHover for direct hex consumers; migrate in #88." },
    "brassLight": { "$value": { "colorSpace": "srgb", "components": [0.709804, 0.929412, 1], "alpha": 1, "hex": "#B5EDFF" }, "$description": "Legacy concrete mirror of palette.ice for direct hex consumers; migrate in #88." }
  },
  "color": {
    "$type": "color",
    "dark": {
      "background": { "$value": "{palette.canvas}" },
      "surface": { "$value": "{palette.panel}" },
      "text": { "$value": "{palette.text}" },
      "muted": { "$value": "{palette.muted}" },
      "border": { "$value": "{palette.line}" },
      "link": { "$value": "{palette.ice}" },
      "linkHover": { "$value": "{palette.text}" },
      "linkActive": { "$value": "{palette.iceHover}" },
      "focus": { "$value": "{palette.ice}" },
      "action": { "$value": "{palette.ice}" },
      "actionHover": { "$value": "{palette.iceHover}" },
      "actionActive": { "$value": "{palette.text}" },
      "onAction": { "$value": "{palette.canvas}" },
      "disabledFill": { "$value": "{palette.panel}" },
      "disabledText": { "$value": "{palette.muted}" },
      "error": { "$value": "{palette.error}" },
      "success": { "$value": "{palette.ice}" }
    },
    "light": {
      "$description": "Deprecated name; aliases the dark-only theme. No light theme or bright inverse band.",
      "background": { "$value": "{color.dark.background}" },
      "surface": { "$value": "{color.dark.surface}" },
      "text": { "$value": "{color.dark.text}" },
      "muted": { "$value": "{color.dark.muted}" },
      "border": { "$value": "{color.dark.border}" },
      "link": { "$value": "{color.dark.link}" },
      "linkHover": { "$value": "{color.dark.linkHover}" },
      "linkActive": { "$value": "{color.dark.linkActive}" },
      "focus": { "$value": "{color.dark.focus}" },
      "action": { "$value": "{color.dark.action}" },
      "actionHover": { "$value": "{color.dark.actionHover}" },
      "actionActive": { "$value": "{color.dark.actionActive}" },
      "onAction": { "$value": "{color.dark.onAction}" },
      "disabledFill": { "$value": "{color.dark.disabledFill}" },
      "disabledText": { "$value": "{color.dark.disabledText}" },
      "error": { "$value": "{color.dark.error}" },
      "success": { "$value": "{color.dark.success}" }
    },
    "inverse": {
      "$description": "Deprecated name; aliases the dark-only theme. No light theme or bright inverse band.",
      "background": { "$value": "{color.dark.background}" },
      "surface": { "$value": "{color.dark.surface}" },
      "text": { "$value": "{color.dark.text}" },
      "muted": { "$value": "{color.dark.muted}" },
      "border": { "$value": "{color.dark.border}" },
      "link": { "$value": "{color.dark.link}" },
      "linkHover": { "$value": "{color.dark.linkHover}" },
      "linkActive": { "$value": "{color.dark.linkActive}" },
      "focus": { "$value": "{color.dark.focus}" },
      "action": { "$value": "{color.dark.action}" },
      "actionHover": { "$value": "{color.dark.actionHover}" },
      "actionActive": { "$value": "{color.dark.actionActive}" },
      "onAction": { "$value": "{color.dark.onAction}" },
      "disabledFill": { "$value": "{color.dark.disabledFill}" },
      "disabledText": { "$value": "{color.dark.disabledText}" },
      "error": { "$value": "{color.dark.error}" },
      "success": { "$value": "{color.dark.success}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "heading": { "$value": ["Public Sans", "Arial", "sans-serif"] },
      "body": { "$value": ["Public Sans", "Arial", "sans-serif"] },
      "label": { "$value": ["monospace"], "$description": "System monospace only; no extra downloaded font." }
    },
    "size": {
      "$type": "dimension",
      "small": { "$value": { "value": 1, "unit": "rem" } },
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "lede": { "$value": { "value": 1.125, "unit": "rem" } },
      "h3": { "$value": { "value": 1.375, "unit": "rem" } },
      "h2Mobile": { "$value": { "value": 2, "unit": "rem" } },
      "h2Desktop": { "$value": { "value": 3.5, "unit": "rem" } },
      "h1Mobile": { "$value": { "value": 2.75, "unit": "rem" } },
      "h1Tablet": { "$value": { "value": 3.125, "unit": "rem" } },
      "h1Desktop": { "$value": { "value": 4.16, "unit": "rem" } },
      "heroWide": { "$value": { "value": 6.5, "unit": "rem" } },
      "pageTitle": { "$value": { "value": 3.5, "unit": "rem" } },
      "label": { "$value": { "value": 0.8125, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 },
      "display": { "$value": 650 }
    },
    "lineHeight": {
      "$type": "number",
      "body": { "$value": 1.6 },
      "heading": { "$value": 1.12 },
      "ui": { "$value": 1.5 },
      "hero": { "$value": 1.04 }
    },
    "tracking": { "$type": "dimension", "$value": { "value": 0, "unit": "rem" } },
    "trackingRatio": {
      "$type": "number",
      "heading": { "$value": -0.04 },
      "hero": { "$value": -0.055 },
      "label": { "$value": 0.05 },
      "$description": "Multiply by 1em for letter-spacing; zero tracking remains font.tracking for body."
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "rem" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "14": { "$value": { "value": 3.5, "unit": "rem" } },
    "18": { "$value": { "value": 4.5, "unit": "rem" } },
    "20": { "$value": { "value": 5, "unit": "rem" } },
    "24": { "$value": { "value": 6, "unit": "rem" } },
    "28": { "$value": { "value": 7, "unit": "rem" } }
  },
  "layout": {
    "$type": "dimension",
    "content": { "$value": { "value": 80, "unit": "rem" } },
    "form": { "$value": { "value": 35, "unit": "rem" } },
    "result": { "$value": { "value": 40, "unit": "rem" } },
    "header": { "$value": { "value": 5, "unit": "rem" } },
    "anchorOffset": { "$value": { "value": 8, "unit": "rem" } },
    "stickyMinHeight": { "$value": { "value": 48, "unit": "rem" } },
    "measure": { "$type": "number", "$value": 65, "$description": "Character measure; CSS max-inline-size: calc(var(--layout-measure) * 1ch)." },
    "heroCopy": { "$value": { "value": 65, "unit": "rem" } },
    "heroLede": { "$value": { "value": 42, "unit": "rem" } },
    "heroDiagram": { "$value": { "value": 58, "unit": "rem" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "compactCta": { "$value": { "value": 30, "unit": "rem" } },
    "tablet": { "$value": { "value": 48, "unit": "rem" } },
    "desktop": { "$value": { "value": 64, "unit": "rem" } },
    "wide": { "$value": { "value": 90, "unit": "rem" } }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": { "value": 2.75, "unit": "rem" } },
    "control": { "$value": { "value": 3, "unit": "rem" } },
    "largeControl": { "$value": { "value": 3.5, "unit": "rem" } },
    "textarea": { "$value": { "value": 10, "unit": "rem" } },
    "icon": { "$value": { "value": 1.25, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "rem" } },
    "small": { "$value": { "value": 0.25, "unit": "rem" } }
  },
  "stroke": {
    "$type": "dimension",
    "border": { "$value": { "value": 1, "unit": "px" } },
    "diagram": { "$value": { "value": 1.5, "unit": "px" } },
    "focus": { "$value": { "value": 3, "unit": "px" } },
    "focusGap": { "$value": { "value": 5, "unit": "px" } }
  },
  "elevation": {
    "flat": { "$type": "shadow", "$description": "Zero geometry: no visible shadow; boundaries use stroke.border.", "$value": { "color": "{palette.canvas}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "header": { "$type": "number", "$value": 10 },
    "skipLink": { "$type": "number", "$value": 20 },
    "glow": { "$type": "shadow", "$description": "Static decorative route glow only; 5px blur, no text or controls within its clipped SVG lane. Never a boundary.", "$value": { "color": "{palette.ice}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 5, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "motion": {
    "none": { "$type": "duration", "$value": { "value": 0, "unit": "ms" } },
    "interaction": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "diagram": { "$type": "duration", "$value": { "value": 1800, "unit": "ms" } },
    "easeOut": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "dispatch": { "$type": "duration", "$value": { "value": 2400, "unit": "ms" } },
    "page": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } },
    "stagger": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } },
    "easeInOut": { "$type": "cubicBezier", "$value": [0.42, 0, 0.58, 1] }
  },
  "border": {
    "$type": "dimension",
    "width": { "$value": "{stroke.border}" },
    "focusWidth": { "$value": "{stroke.focus}" },
    "focusOffset": { "$value": "{stroke.focusGap}" }
  }
}
