{
  "name": "clockvane-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port ${PORT:-4321}",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port ${PORT:-4321}",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
